<?xml version="1.0"?>
<robot name="rebotarm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="model" default="rs"/>
  <xacro:arg name="transport" default="mock"/>
  <xacro:arg name="can_interface" default="can0"/>
  <xacro:arg name="allow_motor_enable" default="false"/>
  <xacro:arg name="hold_only" default="true"/>
  <xacro:arg name="enable_on_controller_start" default="false"/>
  <xacro:arg name="motor_enable_mask" default="0,0,0,0,0,0"/>
  <xacro:arg name="mujoco_headless" default="false"/>
  <xacro:arg name="control_mode" default="position"/>
  <xacro:arg name="sim_speed_factor" default="1.0"/>
  <xacro:arg name="enable_ft_sensor" default="true"/>
  <xacro:arg name="enable_camera" default="false"/>
  <xacro:property name="model" value="$(arg model)"/>
  <xacro:property name="transport" value="$(arg transport)"/>

  <xacro:if value="${model == 'dm'}">
    <xacro:include filename="$(find rebotarm_description)/urdf/dm/urdf/rebotarm_dm.urdf.xacro"/>
  </xacro:if>
  <xacro:if value="${model == 'rs'}">
    <xacro:include filename="$(find rebotarm_description)/urdf/rs/urdf/rebotarm_rs.urdf.xacro"/>
  </xacro:if>

  <xacro:include filename="$(find rebotarm_hardware)/ros2_control/rebotarm.ros2_control.xacro"/>

  <xacro:if value="${transport == 'mujoco'}">
    <link name="wrist_camera_link"/>
    <joint name="wrist_camera_joint" type="fixed">
      <parent link="gripper_tcp"/>
      <child link="wrist_camera_link"/>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </joint>
    <link name="wrist_camera_optical_frame"/>
    <joint name="wrist_camera_optical_joint" type="fixed">
      <parent link="wrist_camera_link"/>
      <child link="wrist_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
    </joint>
    <link name="wrist_camera_mujoco_frame"/>
    <joint name="wrist_camera_mujoco_joint" type="fixed">
      <parent link="wrist_camera_optical_frame"/>
      <child link="wrist_camera_mujoco_frame"/>
      <origin xyz="0 0 0" rpy="3.141593 0 0"/>
    </joint>
  </xacro:if>
  <xacro:rebotarm_ros2_control
    model="${model}"
    transport="${transport}"
    can_interface="$(arg can_interface)"
    allow_motor_enable="$(arg allow_motor_enable)"
    hold_only="$(arg hold_only)"
    enable_on_controller_start="$(arg enable_on_controller_start)"
    motor_enable_mask="$(arg motor_enable_mask)"
    mujoco_headless="$(arg mujoco_headless)"
    control_mode="$(arg control_mode)"
    sim_speed_factor="$(arg sim_speed_factor)"
    enable_ft_sensor="$(arg enable_ft_sensor)"
    enable_camera="$(arg enable_camera)"/>
</robot>
