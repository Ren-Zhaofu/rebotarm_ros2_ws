<mujoco_inputs>
  <raw_inputs>
    <option timestep="0.001" integrator="implicitfast" solver="Newton" gravity="0 0 -9.81"/>
    <default>
      <joint damping="0.15" armature="0.01"/>
      <geom friction="0.8 0.02 0.001" solref="0.01 1" solimp="0.9 0.95 0.001"/>
      <default class="visual"><geom group="2" contype="0" conaffinity="0"/></default>
      <default class="collision"><geom group="3" rgba="0 0 0 0"/></default>
    </default>
    <actuator>
      <motor name="joint1" joint="joint1" ctrlrange="-36 36"/>
      <motor name="joint2" joint="joint2" ctrlrange="-36 36"/>
      <motor name="joint3" joint="joint3" ctrlrange="-36 36"/>
      <motor name="joint4" joint="joint4" ctrlrange="-14 14"/>
      <motor name="joint5" joint="joint5" ctrlrange="-14 14"/>
      <motor name="joint6" joint="joint6" ctrlrange="-14 14"/>
      <position name="gripper_joint1" joint="gripper_joint1" kp="100" dampratio="2" ctrlrange="0 0.05"/>
    </actuator>
    <equality>
      <joint joint1="gripper_joint1" joint2="gripper_joint2" polycoef="0 1 0 0 0" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    </equality>
    <!-- CAD collision boxes overlap in the neutral pose; exclude robot self-collisions. -->
    <contact>
      <exclude body1="world" body2="link1"/>
      <exclude body1="link2" body2="link4"/>
      <exclude body1="link4" body2="link6"/>
      <exclude body1="gripper_left" body2="gripper_right"/>
    </contact>
    <sensor>
      <force name="wrist_force" site="gripper_tcp"/>
      <torque name="wrist_torque" site="gripper_tcp"/>
    </sensor>
  </raw_inputs>
</mujoco_inputs>
