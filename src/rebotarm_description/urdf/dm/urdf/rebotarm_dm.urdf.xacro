<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rebotarm_dm">
  <xacro:include filename="$(find rebotarm_description)/urdf/dm/urdf/rebotarm_dm.urdf"/>
  <link name="base_footprint"/>
  <joint name="base_fixed_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>
  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <origin xyz="-0.0443 0 0" rpy="0 0 0"/>
    <parent link="gripper_link"/>
    <child link="gripper_tcp"/>
  </joint>
</robot>
