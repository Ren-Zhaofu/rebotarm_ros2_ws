<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rebotarm_ros2_control"
    params="model transport:=mock can_interface:=can0 allow_motor_enable:=false motor_enable_mask:='0,0,0,0,0,0'">
    <ros2_control name="RebotArmSystem" type="system">
      <hardware>
        <plugin>rebotarm_hardware/RebotArmSystem</plugin>
        <param name="transport">${transport}</param>
        <param name="model">${model}</param>
        <xacro:if value="${transport == 'socketcan'}">
          <!-- Real-hardware settings are deliberately explicit and DM-only. -->
          <param name="can_interface">${can_interface}</param>
          <param name="allow_motor_enable">${allow_motor_enable}</param>
          <param name="motor_enable_mask">${motor_enable_mask}</param>
          <param name="motor_ids">0x01,0x02,0x03,0x04,0x05,0x06</param>
          <param name="feedback_ids">0x11,0x12,0x13,0x14,0x15,0x16</param>
          <param name="motor_models">dm4340_48v,dm4340_48v,dm4340_48v,dm4310,dm4310,dm4310</param>
          <param name="joint_directions">1,1,1,1,1,1</param>
          <param name="joint_offsets">0,0,0,0,0,0</param>
          <!-- Maximum velocity field sent with mode-2 position targets. -->
          <param name="position_velocity_limits">0.05,0.05,0.05,0.05,0.05,0.05</param>
          <param name="feedback_timeout_ms">100</param>
          <param name="max_command_step">0.05</param>
        </xacro:if>
      </hardware>

      <joint name="joint1">
        <command_interface name="position">
          <param name="min">-2.8</param>
          <param name="max">2.8</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint2">
        <command_interface name="position">
          <param name="min">${-3.14 if model == 'dm' else 0.0}</param>
          <param name="max">${0.0 if model == 'dm' else 3.14}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint3">
        <command_interface name="position">
          <param name="min">${-3.14 if model == 'dm' else 0.0}</param>
          <param name="max">${0.0 if model == 'dm' else 3.14}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint4">
        <command_interface name="position">
          <param name="min">${-1.87 if model == 'dm' else -1.57}</param>
          <param name="max">1.57</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint5">
        <command_interface name="position">
          <param name="min">-1.57</param>
          <param name="max">1.57</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint6">
        <command_interface name="position">
          <param name="min">-3.14</param>
          <param name="max">3.14</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
